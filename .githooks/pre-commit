#!/usr/bin/env bash
# =========================================================================== #
# Description: Pre-commit syntax check.
# =========================================================================== #
set-x
bash_scripts="$(
	git diff --staged --name-only --diff-filter=ACMR \
	-- '*.sh' 'bin/**' '.githooks/**'
)"

if [[ -n "${bash_scripts//[[:space:]]/}" ]]; then
	make lint BASH_SCRIPTS="$bash_scripts"
fi
set +x
