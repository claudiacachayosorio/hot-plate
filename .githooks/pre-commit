#!/usr/bin/env bash
# =========================================================================== #
# Description: Pre-commit linting.
# =========================================================================== #
set -euo pipefail

shell_files="$(
  git diff --staged --name-only --diff-filter=ACMR \
    -- '*.sh' 'bin/**' '.githooks/**'
)"

if [[ -n "$shell_files" ]]; then
  make lint SHELL_FILES="${shell_files//$'\n'/ }"
fi
