#!/usr/bin/env bash
# =========================================================================== #
# Description: Pre-commit linting.
# =========================================================================== #
set -euo pipefail

raw_shell_files="$(
  git diff --staged --name-only --diff-filter=ACMR \
    -- '*.sh' 'bin/**' '.githooks/**'
)"

shell_files="${raw_shell_files//$'\n'/ }"

if [[ -z "$shell_files" ]]; then
  exit 0
fi

make fmt-check SHELL_FILES="$shell_files"
make lint SHELL_FILES="$shell_files"
